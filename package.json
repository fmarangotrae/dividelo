{
  "name": "dividelo",
  "private": true,
  "version": "0.1.0",
  "description": "Plataforma colombiana para compartir suscripciones multiusuario",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev:web": "npm run dev --workspace=@dividelo/web",
    "dev:api": "npm run dev --workspace=@dividelo/api",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "db:generate": "npm run generate --workspace=@dividelo/db",
    "db:migrate": "npm run migrate:dev --workspace=@dividelo/db",
    "db:studio": "npm run studio --workspace=@dividelo/db"
  },
  "devDependencies": {
    "turbo": "^2.1.0",
    "typescript": "^5.5.4",
    "prettier": "^3.3.3",
    "@types/node": "^20.14.10"
  }
}
