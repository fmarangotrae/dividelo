# ==============================================
# VARIABLES GENERALES
# ==============================================
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
JWT_SECRET=cambia-este-secreto-en-produccion-abcdef123456
JWT_EXPIRES_IN=7d

# ==============================================
# BASE DE DATOS (SUPABASE / POSTGRES)
# ==============================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dividelo?schema=public

# ==============================================
# PASARELAS DE PAGO (COLOMBIA)
# ==============================================
# WOMPI (Bancolombia)
WOMPI_PUBLIC_KEY=pub_test_...
WOMPI_PRIVATE_KEY=prv_test_...
WOMPI_WEBHOOK_SECRET=wompi_webhook_secret
WOMPI_ENVIRONMENT=sandbox
WOMPI_REDIRECT_URL_SUCCESS=http://localhost:3000/payment/success
WOMPI_REDIRECT_URL_FAILURE=http://localhost:3000/payment/failure

# PLACETOPAY (Evertec)
PLACETOPAY_LOGIN=...
PLACETOPAY_TRAN_KEY=...
PLACETOPAY_BASE_URL=https://test.placetopay.com/redirection
PLACETOPAY_WEBHOOK_SECRET=placetopay_webhook_secret
PLACETOPAY_REDIRECT_URL_SUCCESS=http://localhost:3000/payment/success
PLACETOPAY_REDIRECT_URL_FAILURE=http://localhost:3000/payment/failure

# URL del frontend para redirecciones (producción)
NEXT_PUBLIC_APP_URL=https://tudominio.com

# ==============================================
# PROVEEDOR KYC (VERIK / TRUORA)
# ==============================================
KYC_PROVIDER=verifik
VERIFIK_API_KEY=...
TRUORA_API_KEY=...

# ==============================================
# EMAIL (RESEND)
# ==============================================
RESEND_API_KEY=...
EMAIL_FROM=Dividelo <hola@dividelo.co>

# ==============================================
# OBSERVABILIDAD
# ==============================================
BETTER_STACK_SOURCE_TOKEN=...
